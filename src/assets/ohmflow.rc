/* ohmflow.rc — recursos do executável Windows */
1 ICON "src/assets/ohmflow.ico"

/* Versão mostrada em Propriedades > Detalhes. O Makefile passa
 * -DVERSAO=1.0.0 e -DVERSAO_NUM=1,0,0,0 (padrões abaixo para builds avulsos). */
#ifndef VERSAO
#define VERSAO 0.0.0-dev
#endif
#ifndef VERSAO_NUM
#define VERSAO_NUM 0,0,0,0
#endif
#define TEXTO_(x) #x
#define TEXTO(x)  TEXTO_(x)

1 VERSIONINFO
FILEVERSION    VERSAO_NUM
PRODUCTVERSION VERSAO_NUM
FILEOS         0x40004
FILETYPE       0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName",      "Grolla05"
      VALUE "FileDescription",  "OhmFlow - Controle de estoque de resistores"
      VALUE "FileVersion",      TEXTO(VERSAO)
      VALUE "InternalName",     "ohmflow"
      VALUE "LegalCopyright",   "Copyright (c) 2026 Grolla05 (MIT)"
      VALUE "OriginalFilename", "ohmflow.exe"
      VALUE "ProductName",      "OhmFlow"
      VALUE "ProductVersion",   TEXTO(VERSAO)
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x416, 1200
  END
END
